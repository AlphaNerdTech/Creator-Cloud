# Creator Cloud - Ingest Config (EXAMPLE)
# Copy to config.env and edit. Do NOT commit config.env.

# Persistent writable location (My workflow uses ANT_Files as pool name)
INGEST_ROOT="/media/ANT_Files/CreatorCloud/Library"
LOG_DIR="/media/ANT_Files/CreatorCloud/logs"

# Skip mounts under /media that are NOT camera cards (pipe-separated)
SKIP_MOUNTS="ANT_Files|Ingest|scripts|ZimaOS-HD"

# Safety
DRY_RUN="false"   # true = log actions only, no copying

# Where the ingest script lives on your box (for watcher)
INGEST_SCRIPT_PATH="/media/ANT_Files/CreatorCloud/scripts/auto_ingest.sh"

# Watcher cooldown (seconds)
COOLDOWN_SECONDS="30"
POLL_SECONDS="2"
