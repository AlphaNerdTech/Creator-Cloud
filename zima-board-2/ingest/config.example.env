# Example config for Creator Cloud ingest
# Copy this file to config.env and customize.
# NEVER commit your real config.env.

# Where to copy footage to (local path on ZimaBoard)
DEST_ROOT="/mnt/storage/CreatorCloud"

# Folder naming
PROJECT_NAME="CreatorCloud"
CAMERA_NAME="CameraA"   # e.g. R50, OP3, iPhone, GoPro
DATE_FORMAT="%Y-%m-%d"

# Ingest behavior
COPY_MODE="copy"        # copy | move   (default: copy)
VERIFY_MODE="basic"     # off | basic   (basic compares file sizes)
DRY_RUN="false"         # true prints actions without copying

# What to ingest from the media card
SOURCE_SUBDIR=""        # leave blank to ingest whole card, or set like "DCIM"
INCLUDE_EXT="MP4,MOV,JPG,JPEG,PNG,WAV"   # comma-separated, case-insensitive
EXCLUDE_DIRS="MISC,PRIVATE,.*"           # comma-separated directory names/patterns

# Logging
LOG_DIR="/mnt/storage/CreatorCloud/_logs"
