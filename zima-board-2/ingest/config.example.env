# Creator Cloud ingest config (example)
# Copy to /media/ANT_Files/CreatorCloud/config/ingest.env on your ZimaBoard

# Where we scan for mounts
MEDIA_GLOB="/media/*"

# Ignore these mounts
IGNORE_MOUNTS_REGEX="^(ANT_Files|ZimaOS-HD)$"

# Prevent re-processing the same card repeatedly
PROCESSED_TTL_SECONDS="7200"

# Minimum free space required on Library filesystem
MIN_FREE_GB="10"

# Optional include filter (example: only videos)
# INCLUDE_REGEX="\\.(mp4|mov)$"

# Safer copy behavior (write .part then rename)
SAFE_COPY_MODE="1"

# Watcher polling interval (seconds)
POLL_SECONDS="5"

# If you move the ingest script somewhere else, set it here
# AUTO_INGEST_PATH="/media/ANT_Files/CreatorCloud/bin/auto_ingest.sh"
